{
  "builtin_components": [
    "ooxml-parser",
    "sqlite-fts5-store",
    "atomic-snapshot-publisher"
  ],
  "idle_timeout_seconds": 300.0,
  "license": "Apache-2.0 (OpenCV, ONNX Runtime, RapidOCR); MIT (this project)",
  "model_artifacts": [],
  "name": "core",
  "notes": [
    "The builtin components ship with the project itself; only the OCR artifacts have to be installed."
  ],
  "optional": false,
  "purpose": "Deterministic OOXML parsing, SQLite/FTS storage, OpenCV geometry, and RapidOCR on ONNX Runtime for ordinary image text.",
  "python_artifacts": [
    {
      "distribution": "opencv-python",
      "module": "cv2",
      "purpose": "deterministic image geometry",
      "version": "4.10.0.84"
    },
    {
      "distribution": "rapidocr-onnxruntime",
      "module": "rapidocr_onnxruntime",
      "purpose": "core OCR engine",
      "version": "1.3.24"
    },
    {
      "distribution": "onnxruntime",
      "module": "onnxruntime",
      "purpose": "CPU inference runtime",
      "version": "1.19.2"
    }
  ],
  "python_dependencies": [
    {
      "distribution": "numpy",
      "purpose": "array backend for RapidOCR and OpenCV",
      "version": "1.26.4"
    },
    {
      "distribution": "shapely",
      "purpose": "RapidOCR geometry",
      "version": "2.1.2"
    },
    {
      "distribution": "pyclipper",
      "purpose": "RapidOCR polygon clipping",
      "version": "1.4.0"
    },
    {
      "distribution": "pillow",
      "purpose": "image decoding",
      "version": "12.3.0"
    },
    {
      "distribution": "pyyaml",
      "purpose": "RapidOCR configuration",
      "version": "6.0.3"
    },
    {
      "distribution": "six",
      "purpose": "RapidOCR compatibility shim",
      "version": "1.17.0"
    },
    {
      "distribution": "packaging",
      "purpose": "version parsing",
      "version": "26.3"
    },
    {
      "distribution": "coloredlogs",
      "purpose": "onnxruntime console output",
      "version": "15.0.1"
    },
    {
      "distribution": "humanfriendly",
      "purpose": "coloredlogs formatting",
      "version": "10.0"
    },
    {
      "distribution": "pyreadline3",
      "purpose": "humanfriendly console support",
      "version": "3.5.6"
    },
    {
      "distribution": "flatbuffers",
      "purpose": "onnxruntime serialization",
      "version": "25.12.19"
    },
    {
      "distribution": "protobuf",
      "purpose": "onnxruntime serialization",
      "version": "7.36.2"
    },
    {
      "distribution": "sympy",
      "purpose": "onnxruntime symbolic shapes",
      "version": "1.14.0"
    },
    {
      "distribution": "mpmath",
      "purpose": "sympy arbitrary precision",
      "version": "1.3.0"
    }
  ],
  "requirements": {
    "cpu_cores": 4,
    "free_disk_gb": 4.0,
    "ram_gb": 8.0
  },
  "sizes_mb": {
    "download": 420.0,
    "installed": 1150.0
  },
  "tier": "core",
  "version": "1.0.0"
}
