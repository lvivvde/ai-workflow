{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game Design Knowledge Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "features"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "canonical_name", "source", "aliases"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "canonical_name": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "aliases": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "source", "confirmed_at", "confirmed_by"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "source": { "type": "string", "minLength": 1 },
                "confirmed_at": { "type": "string", "minLength": 1 },
                "confirmed_by": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
